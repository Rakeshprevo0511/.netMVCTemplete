@{
    ViewBag.Title = "Content Editor";
}


    <div class="mb-3">
        <label class="form-label">Title</label>
        <input type="text"
               id="txtTitle"
               class="form-control"
               placeholder="Enter Title" />
    </div>

    <text id="editor"></text>

    <div class="mt-3">
        <button type="button" class="btn btn-success" id="btnSave">
            Save Content
        </button>

        <button type="button" class="btn btn-secondary" id="btnClear">
            Clear
        </button>
    </div>

    <hr />

    <h4>Saved Contents</h4>

    <table class="table table-bordered table-striped" id="tblContent">
        <thead class="table-dark">
            <tr>
                <th style="width:70px;">Id</th>
                <th>Title</th>
                <th style="width:180px;">Created Date</th>
                <th style="width:100px;">Action</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/Content/HtmlTemplateEditor/html-editor.bundle.js"></script>

<script>

    let ContentId = 0;

    const editor = HtmlEditor.create({
        element: "#editor"
    });

    $(function () {
        loadAllContent();
    });

    //================ SAVE ==================

    $("#btnSave").click(function () {

        var model = {
            Id: ContentId,
            Title: $("#txtTitle").val(),
            HtmlContent: editor.getHTML()
        };

        const maxSize = 1024 * 1024;
        const size = new Blob([model.HtmlContent]).size;

        if (!validationHelper.required(model.Title)) {
            showToast("Please enter title.", "warning");
            $("#txtTitle").focus();
            return;
        }

        if (!validationHelper.required(model.HtmlContent)) {
            showToast("Please enter content.", "warning");
            return;
        }

        if (size > maxSize) {
            showToast("HTML content cannot exceed 1 MB.", "warning");
            return;
        }

        ajaxHelper.post(
            "/api/admin/set-content",
            model,
            {
                button: "#btnSave"
            })
            .then(function (res) {

                if (res.Success) {

                    showToast(res.Message);

                    clearForm();

                    loadAllContent();
                }
                else {

                    showToast(res.Message, "error");
                }

            })
            .catch(function (xhr) {

                var msg = "Something went wrong.";

                if (xhr.responseJSON &&
                    xhr.responseJSON.Errors &&
                    xhr.responseJSON.Errors.length) {

                    msg = xhr.responseJSON.Errors[0];
                }

                showToast(msg, "error");

            });

    });

    //================ LOAD ALL ==================

    function loadAllContent() {
        tableHelper.skeleton("#tblContent tbody", 4, 5);

        ajaxHelper.get("/api/admin/get-all-content")
            .then(function (res) {

                tableHelper.bind({

                    table: "#tblContent tbody",

                    columns: 4,

                    data: res.Success ? res.Data : [],

                    emptyMessage: "No Record Found",

                    row: function (item,row) {

                        return $("<tr>")
                            .append($("<td>").text(tableHelper.serialNo(1, 4, row)))
                            .append($("<td>").text(item.Title))
                            .append($("<td>").text(tableHelper.date(item.CreatedDate)))
                            .append(
                                $("<td>")
                                    .append(tableHelper.actions.edit(item.Id))
                                    .append(tableHelper.actions.delete(item.Id))
                            );

                    }

                });

            })
            .catch(function () {

                tableHelper.error("#tblContent tbody", 4, "Unable to load records.");

            });

    }

    //================ EDIT ==================

    $(document).on("click", ".btnEdit", function () {

        var id = $(this).data("id");

        ajaxHelper.get("/api/admin/get-content/" + id)
            .then(function (res) {

                if (!res.Success) {

                    showToast(res.Message, "error");
                    return;
                }

                if (!res.Data || res.Data.length === 0) {

                    showToast("Record not found.", "error");
                    return;
                }

                var item = res.Data[0];

                ContentId = item.Id;

                $("#txtTitle").val(item.Title);

                editor.setHTML(item.HtmlContent);

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            })
            .catch(function () {

                showToast("Unable to load record.", "error");

            });

    });
    $(document).on("click", ".btnDelete", function () {

        var id = $(this).data("id");

        modalHelper.confirm({

            title: "Delete Content",

            heading: "Delete Confirmation",

            subHeading: "This action cannot be undone.",

            message: "Are you sure you want to permanently delete this content?",

            icon: "bi-trash-fill text-danger",

            buttonText: "Delete",

            buttonClass: "btn-danger",

            confirmIcon: "bi-trash",

            cancelText: "Cancel",

            cancelClass: "btn-secondary",

            cancelIcon: "bi-x-circle",

            showLoader: true,

            loaderText: "Deleting...",

            closeOnConfirm: false,

            onConfirm: function () {

                deleteContent(id);

            }

        });

    });
    function deleteContent(id) {

        ajaxHelper.delete("/api/admin/delete-content/" + id)

            .then(function (response) {

                if (response.Success) {

                    modalHelper.hide("#confirmModal");

                    showToast(response.Message || "Content deleted successfully.", "success");

                    loadAllContent(); // Reload your table

                }
                else {

                    modalHelper.resetConfirmButton();

                    showToast(response.Message || "Unable to delete content.", "error");

                }

            })

            .catch(function (error) {

                console.error(error);

                modalHelper.resetConfirmButton();

                showToast("Something went wrong while deleting the content.", "error");

            });

    }
    //================ CLEAR ==================

    $("#btnClear").click(function () {

        clearForm();

    });

    function clearForm() {

        ContentId = 0;

        $("#txtTitle").val("");

        editor.setHTML("");

    }

</script>