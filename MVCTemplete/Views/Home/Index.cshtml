@{
    ViewBag.Title = "Home Page";
}

<main>
    @{
        ViewBag.Title = "Dashboard";
    }

    <div class="container-fluid mt-4">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold">Dashboard</h2>
                <p class="text-muted mb-0">Welcome to the Admin Panel</p>
            </div>

            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add User
            </button>
        </div>

        <!-- Statistics -->
        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Total Users</h6>
                            <h2 class="fw-bold">250</h2>
                        </div>

                        <div class="dashboard-icon bg-primary text-white">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Departments</h6>
                            <h2 class="fw-bold">12</h2>
                        </div>

                        <div class="bg-success text-white dashboard-icon ">
                            <i class="bi bi-building fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Roles</h6>
                            <h2 class="fw-bold">8</h2>
                        </div>

                        <div class="bg-warning text-white dashboard-icon ">
                            <i class="bi bi-person-badge fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Active Users</h6>
                            <h2 class="fw-bold">220</h2>
                        </div>

                        <div class="bg-danger text-white dashboard-icon ">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Quick Actions -->

        <div class="row mt-4">

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">

                        <i class="bi bi-person-plus fs-1 text-primary"></i>

                        <h5 class="mt-3">Users</h5>

                        <p class="text-muted">
                            Manage all system users.
                        </p>

                        <a href="#" class="btn btn-primary">
                            Manage Users
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">

                        <i class="bi bi-shield-lock fs-1 text-success"></i>

                        <h5 class="mt-3">Roles</h5>

                        <p class="text-muted">
                            Assign permissions & roles.
                        </p>

                        <a href="#" class="btn btn-success">
                            Manage Roles
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">

                        <i class="bi bi-building fs-1 text-warning"></i>

                        <h5 class="mt-3">Departments</h5>

                        <p class="text-muted">
                            Manage departments.
                        </p>

                        <a href="#" class="btn btn-warning text-white">
                            View Departments
                        </a>

                    </div>
                </div>
            </div>

        </div>

        <!-- Recent Users -->

        <div class="card shadow-sm border-0 mt-3">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Recent Users
                </h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light" id="usersTableHead">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="usersTableBody">
                            <tr>
                                <td colspan="5" class="text-center text-muted">Loading users&hellip;</td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</main>

@section scripts {
    <script>
        $(function () {
            loadRecentUsers();
        });

        // Every protected endpoint on this page should be called through
        // ajaxHelper (see Scripts/app/ajaxHelper.js) instead of $.ajax
        // directly: it transparently handles an expired access token by
        // refreshing the session and retrying this same call once, with
        // no page reload and no manual per-page refresh logic.
        function loadRecentUsers() {

            ajaxHelper.get("/api/admin/users", { pageNumber: 1, pageSize: 5 })
                .then(function (res) {

                    tableHelper.bind({

                        table: "#usersTableBody",

                        columns: 6,

                        data: res.Data,

                        emptyMessage: "No users found.",

                        row: function (row, index) {

                            return $("<tr>")
                                .append($("<td>").text(tableHelper.serialNo(1, 5, index)))
                                .append($("<td>").text([row.FirstName, row.LastName].filter(Boolean).join(" ") || row.Name || "-"))
                                .append(
                                    $("<td>")
                                        .text(row.Email + " ")
                                        .append(tableHelper.copy(row.Email))
                                )
                                .append($("<td>").text(row.RoleName || "-"))
                                .append($("<td>").append(tableHelper.toggle(row.IsActive, row.Id, "statusToggle")))
                                .append($("<td>").text(row.CreatedDate || "-"))
                                .append(
                                    $("<td>")
                                        .addClass("text-center")
                                        .append(tableHelper.actions.view(row.Id))
                                        .append(tableHelper.actions.edit(row.Id))
                                        .append(tableHelper.actions.delete(row.Id))
                                );

                        }

                    });

                })
                .catch(function () {

                    tableHelper.error("#usersTableBody", 6, "Could not load users.");

                });

        }
        $(document).on("click", ".btnDelete", function () {

            var id = $(this).data("id");

            modalHelper.confirm({

                title: "Delete User",

                heading: "Delete Confirmation",

                subHeading: "This action cannot be undone.",

                message: "Are you sure you want to delete this user?",

                icon: "bi-trash-fill text-danger",

                buttonText: "Delete",

                buttonClass: "btn-danger",

                confirmIcon: "bi-trash",

                showLoader: true,

                loaderText: "Deleting...",

                onConfirm: function () {

                    deleteUser(id);

                }

            });

        });
        function deleteUser(id) {

            ajaxHelper.delete("/api/users/" + id)
                .then(function (response) {

                    if (response.Success) {

                        showToast(response.Message || "User deleted successfully.", "success");

                        loadUsers(); // Refresh grid

                    } else {

                        showToast(response.Message || "Unable to delete user.", "error");

                    }

                })
                .catch(function (error) {

                    console.error(error);

                    showToast("Something went wrong while deleting the user.", "error");

                });

        }
    </script>
}