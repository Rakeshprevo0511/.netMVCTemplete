@{
    ViewBag.Title = "Home Page";
}

<main>
    @{
        ViewBag.Title = "Dashboard";
    }

    <div class="container-fluid mt-4">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold">Dashboard</h2>
                <p class="text-muted mb-0">Welcome to the Admin Panel</p>
            </div>

            <button class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add User
            </button>
        </div>

        <!-- Statistics -->
        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Total Users</h6>
                            <h2 class="fw-bold">250</h2>
                        </div>

                        <div class="bg-primary text-white rounded-circle p-3">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Departments</h6>
                            <h2 class="fw-bold">12</h2>
                        </div>

                        <div class="bg-success text-white rounded-circle p-3">
                            <i class="bi bi-building fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Roles</h6>
                            <h2 class="fw-bold">8</h2>
                        </div>

                        <div class="bg-warning text-white rounded-circle p-3">
                            <i class="bi bi-person-badge fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Active Users</h6>
                            <h2 class="fw-bold">220</h2>
                        </div>

                        <div class="bg-danger text-white rounded-circle p-3">
                            <i class="bi bi-check-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Quick Actions -->

        <div class="row mt-4">

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">

                        <i class="bi bi-person-plus fs-1 text-primary"></i>

                        <h5 class="mt-3">Users</h5>

                        <p class="text-muted">
                            Manage all system users.
                        </p>

                        <a href="#" class="btn btn-primary">
                            Manage Users
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">

                        <i class="bi bi-shield-lock fs-1 text-success"></i>

                        <h5 class="mt-3">Roles</h5>

                        <p class="text-muted">
                            Assign permissions & roles.
                        </p>

                        <a href="#" class="btn btn-success">
                            Manage Roles
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">

                        <i class="bi bi-building fs-1 text-warning"></i>

                        <h5 class="mt-3">Departments</h5>

                        <p class="text-muted">
                            Manage departments.
                        </p>

                        <a href="#" class="btn btn-warning text-white">
                            View Departments
                        </a>

                    </div>
                </div>
            </div>

        </div>

        <!-- Recent Users -->

        <div class="card shadow-sm border-0 mt-3">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Recent Users
                </h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>John Smith</td>
                                <td>john@example.com</td>
                                <td>Admin</td>
                                <td>
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                </td>
                                <td>20 Jul 2026</td>
                            </tr>

                            <tr>
                                <td>Rakesh</td>
                                <td>rakesh@example.com</td>
                                <td>User</td>
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                </td>
                                <td>18 Jul 2026</td>
                            </tr>

                            <tr>
                                <td>David</td>
                                <td>david@example.com</td>
                                <td>Manager</td>
                                <td>
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                </td>
                                <td>15 Jul 2026</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</main>