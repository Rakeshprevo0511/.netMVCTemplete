@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            font-family: "Segoe UI", sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background: linear-gradient(-45deg, #667eea, #764ba2, #6dd5ed, #2193b0);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            animation: fadeIn 0.8s ease;
            display: none;
        }

        @@media (max-width: 576px) {
            .login-card {
                margin: 20px;
                padding: 25px;
            }
        }

        @@keyframes gradientBG {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="login-card" id="loginCard">
        <h3 class="text-center mb-4">Login</h3>

        <div class="mb-3">
            <label for="txtUsername" class="form-label">Username</label>
            <input type="text"
                   id="txtUsername"
                   class="form-control"
                   placeholder="Enter Username" />
        </div>

        <div class="mb-3">
            <label for="txtPassword" class="form-label">Password</label>
            <input type="password"
                   id="txtPassword"
                   class="form-control"
                   placeholder="Enter Password" />
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="chkRememberMe" />
            <label class="form-check-label" for="chkRememberMe">Remember Me</label>
        </div>

        <button type="button" id="btnLogin" class="btn btn-primary w-100">
            Login
        </button>

        <div id="message" class="mt-3 text-danger"></div>
    </div>

    <div class="position-fixed top-0 end-0 p-3" style="z-index: 11000;">
        <div id="appToast"
             class="toast align-items-center text-bg-success border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">
            <div class="d-flex">
                <div id="toastBody" class="toast-body"></div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @* Same centralized helper used everywhere else in the app. noRedirect:true
       is used below because we're already ON the login page - if the session
       can't be silently restored we just want to show the form, not bounce
       through /Home/Login again. The ?v= query string is a manual cache-buster. *@
    <script src="~/Scripts/app/ajaxHelper.js?v=3"></script>

    <script>
        $(function () {
            checkLogin();

            $("#btnLogin").on("click", function () {
                login();
            });

            $("#txtUsername, #txtPassword").on("keypress", function (e) {
                if (e.which === 13) {
                    login();
                }
            });
        });

        function checkLogin() {
            // ajaxHelper already runs the full remember-me -> refresh -> retry
            // sequence internally on a 401 (single-flight, race-safe). If that
            // succeeds, this resolves and we go straight to the app; if not,
            // we just show the login form.
            ajaxHelper.request({ url: "/api/admin/validate-token", type: "POST", noRedirect: true })
                .then(function () {
                    window.location.href = "/Home/Index";
                })
                .catch(function () {
                    $("#loginCard").show();
                });
        }

        function login() {
            var username = $("#txtUsername").val().trim();
            var password = $("#txtPassword").val().trim();
            var rememberMe = $("#chkRememberMe").is(":checked");

            if (username === "" || password === "") {
                $("#message").text("Username and Password are required.");
                return;
            }

            $("#message").text("");

            ajaxHelper.post("/api/admin/login", {
                username: username,
                password: password,
                rememberMe: rememberMe
            }, { noRedirect: true, button: "#btnLogin" })
                .then(function () {

                    showToast("Login Successful", "success");

                    $("#btnLogin")
                        .prop("disabled", true)
                        .html('<span class="spinner-border spinner-border-sm me-2"></span>Redirecting...');

                    $("#txtUsername").prop("disabled", true);
                    $("#txtPassword").prop("disabled", true);
                    $("#chkRememberMe").prop("disabled", true);

                    setTimeout(function () {
                        window.location.href = "/Home/Index";
                    }, 1500);

                })
                .catch(function (xhr) {
                    if (xhr.status === 401) {
                        $("#message").text("Invalid Username or Password");
                    } else {
                        $("#message").text("Something went wrong.");
                    }
                });
        }

        function showToast(message, type) {
            var toastElement = $("#appToast");
            var toastBody = $("#toastBody");

            toastElement.removeClass("text-bg-success text-bg-danger text-bg-warning text-bg-info");

            if (type === "success") {
                toastElement.addClass("text-bg-success");
            } else if (type === "error") {
                toastElement.addClass("text-bg-danger");
            } else if (type === "warning") {
                toastElement.addClass("text-bg-warning");
            } else {
                toastElement.addClass("text-bg-info");
            }

            toastBody.text(message);

            var toast = new bootstrap.Toast(document.getElementById("appToast"), {
                delay: 3000
            });

            toast.show();
        }
    </script>
</body>
</html>