<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
 

</head>
<body>

    <!-- Shown until auth is confirmed -->
    <div id="authOverlay">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="text-muted">Loading...</span>
    </div>

    <!-- Real page content, hidden until auth is confirmed -->
    <div id="appContent">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark fixed-top shadow">
            <div class="container">
                @Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("About", "About", "Home", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Contact", "Contact", "Home", null, new { @class = "nav-link" })</li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a href="javascript:void(0);" class="nav-link text-danger" onclick="logout()">
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container-fluid body-content ">
            @RenderBody()
            <hr />
            <footer>
                <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
            </footer>
        </div>
    </div>

    @* jQuery + Bootstrap MUST load before any script that uses $ or data-bs-* *@
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @* Centralized 401 -> remember-me -> refresh -> retry logic (+ global loader,
        + button loading state). Every API call on every page should go through
        ajaxHelper (see Scripts/app/ajaxHelper.js) instead of calling $.ajax
        directly, so this behavior stays consistent. The ?v= query string is a
        manual cache-buster — bump it any time this file changes. *@
    <script src="~/Scripts/app/ajaxHelper.js?v=3"></script>
    <script src="~/Scripts/app/validationHelper.js"></script>
    <script src="~/Scripts/app/modalHelper.js"></script>
    <script src="~/Scripts/app/tableHelper.js"></script>
    <script>
        $(document).ready(function () {

            checkAuthentication();

        });

        function showApp() {
            document.getElementById("authOverlay").style.display = "none";
            document.getElementById("appContent").style.display = "block";
        }

        function checkAuthentication() {

            // ajaxHelper.request already handles the full 401 -> remember-me ->
            // refresh -> retry sequence internally (single-flight, no page
            // reload). We only need to react to the final outcome here.
            ajaxHelper.request({ url: "/api/admin/validate-token", type: "POST", silent: true })
                .then(function () {
                    showApp();
                })
                .catch(function () {
                    // ajaxHelper already triggered redirectToLogin() for the
                    // unrecoverable case; this is just a safety net.
                    ajaxHelper.redirectToLogin();
                });

        }

        function logout() {

            modalHelper.confirm({

                title: "Logout",

                heading: "Sign Out",

                subHeading: "Your current session will be terminated.",

                message: "Are you sure you want to logout? Any unsaved changes may be lost.",

                icon: "bi-box-arrow-right text-warning",

                buttonText: "Logout",

                buttonClass: "btn-warning",

                confirmIcon: "bi-box-arrow-right",

                cancelText: "Stay Logged In",

                cancelClass: "btn-outline-secondary",

                cancelIcon: "bi-x-circle",

                showLoader: true,

                loaderText: "Signing out...",

                closeButton: true,

                backdrop: "static",

                keyboard: false,

                closeOnConfirm: true,

                closeOnCancel: true,

                beforeShow: function () {
                    console.log("Logout confirmation opened.");
                },

                afterShow: function () {
                    $("#btnConfirmAction").focus();
                },

                onConfirm: function () {

                    ajaxHelper.redirectToLogin();

                },

                onCancel: function () {

                    showToast("Logout cancelled.", "info");

                },

                afterHide: function () {

                    console.log("Logout dialog closed.");

                }

            });

        }

        function showToast(message, type = "success") {

            var toast = $("#appToast");

            toast.removeClass("text-bg-success text-bg-danger text-bg-warning text-bg-info");

            switch (type) {

                case "success":
                    toast.addClass("text-bg-success");
                    break;

                case "error":
                    toast.addClass("text-bg-danger");
                    break;

                case "warning":
                    toast.addClass("text-bg-warning");
                    break;

                default:
                    toast.addClass("text-bg-info");
                    break;
            }

            $("#toastBody").text(message);

            var bsToast = bootstrap.Toast.getOrCreateInstance(
                document.getElementById("appToast"),
                {
                    delay: 3000
                });

            bsToast.show();
        }
    </script>
    @RenderSection("scripts", false)
    <div class="position-fixed top-0 end-0 p-3" style="z-index:11000">

        <div id="appToast"
             class="toast align-items-center border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="d-flex">

                <div id="toastBody" class="toast-body">
                    Message
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>

            </div>

        </div>

    </div>
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" id="confirmModalDialog">
            <div class="modal-content shadow">

                <div class="modal-header">

                    <h5 class="modal-title" id="confirmTitle">
                        Confirmation
                    </h5>

                    <button type="button"
                            class="btn-close"
                            id="confirmCloseButton"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="d-flex align-items-start">

                        <div class="me-3">
                            <i id="confirmIcon"
                               class="bi bi-question-circle-fill fs-1 text-warning">
                            </i>
                        </div>

                        <div class="flex-grow-1">

                            <h6 id="confirmHeading" class="mb-1"></h6>

                            <small id="confirmSubHeading"
                                   class="text-muted d-block mb-2">
                            </small>

                            <div id="confirmMessage" class="text-muted">
                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            id="btnCancelAction"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="btnConfirmAction"
                            class="btn btn-primary">
                        Confirm
                    </button>

                </div>

            </div>
        </div>
    </div>
</body>
</html>